# Normalise line endings so builds behave the same on Windows and on the Linux CI runner.
* text=auto

# The Gradle wrapper script must keep LF endings or it fails on Linux.
gradlew text eol=lf
*.bat text eol=crlf
*.sh text eol=lf

# Binary files: never touch.
*.jar binary
*.png binary
*.webp binary
*.jpg binary
